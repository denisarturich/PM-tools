# Database Configuration
# Production database через SSH tunnel
DATABASE_URL="postgresql://pmtools:YOUR_PASSWORD@localhost:5433/pmtools?schema=public"

# SSH Tunnel Configuration (для справки)
# ssh -L 5433:localhost:5432 pmtools@YOUR_SERVER_IP
# SSH Host: YOUR_SERVER_IP
# SSH User: root
# SSH Password: YOUR_SSH_PASSWORD

# Server Configuration
NODE_ENV="development"
PORT=3000
HOST="127.0.0.1"

# ============================================
# 🤖 AI ASSISTANT НАСТРОЙКА
# ============================================
# 1. Получите ключ на https://console.anthropic.com/
# 2. Замените YOUR_ANTHROPIC_API_KEY на ваш ключ (начинается с sk-ant-api03-)
# 3. Перезапустите сервер
# 4. В интерфейсе: Settings (⚙️) → включите "AI Assistant"
# ============================================

ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=2000
AI_FEATURE_ENABLED=true
